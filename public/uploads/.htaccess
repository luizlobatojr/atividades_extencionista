# Evita listagem e execução de scripts na pasta de uploads
Options -Indexes

# Negar execução de scripts
<FilesMatch "\.(php|phtml|php5|phar)$">
  Require all denied
</FilesMatch>

# Permitir apenas arquivos estáticos (ajuste conforme necessidade)
<IfModule mod_authz_core.c>
  <FilesMatch "\.(pdf|doc|docx|jpg|jpeg|png|gif)$">
    Require all granted
  </FilesMatch>
</IfModule>
